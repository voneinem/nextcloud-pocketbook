pragma Singleton
import QtQuick

// What the app tells the user about a problem with the connection, and what to do about it: one message and one "what to do" line per
// cause key (specs/001-nextcloud-files-client FR-006). The keys are those of the core (contracts/server-requests.md). Neither text ever
// holds an address, a user name or a name from the server.
QtObject {
    function title(key) {
        switch (key) {
        case "": return ""
        case "scheme_not_allowed": return qsTr("Only https addresses are accepted.")
        case "address_invalid": return qsTr("The address is not valid.")
        case "clock_implausible": return qsTr("The reader's date and time are wrong.")
        case "no_network": return qsTr("There is no network connection.")
        case "server_unreachable": return qsTr("The server cannot be reached.")
        case "timeout": return qsTr("The server did not answer in time.")
        case "cert_untrusted": return qsTr("The server's certificate is not trusted by this reader.")
        case "cert_expired": return qsTr("The server's certificate is expired or not valid yet.")
        case "cert_host_mismatch": return qsTr("The certificate does not belong to this address.")
        case "not_nextcloud": return qsTr("This address does not answer like a Nextcloud.")
        case "maintenance": return qsTr("The server is in maintenance mode.")
        case "server_too_old": return qsTr("This Nextcloud version is too old.")
        case "auth_failed": return qsTr("The user name or the app password is wrong.")
        case "auth_app_password_required": return qsTr("An app password is needed.")
        case "no_webdav": return qsTr("The server has no file access at this address.")
        case "forbidden": return qsTr("The server refused access to your files.")
        case "rate_limited": return qsTr("The server asks for a pause.")
        case "redirect_other_host": return qsTr("The server wants to send you to another address.")
        case "login_failed": return qsTr("The login did not finish.")
        case "login_expired": return qsTr("The login ran out of time.")
        case "protocol_error":
        case "malformed_xml": return qsTr("The answer of the server could not be understood.")
        case "storage_full":
        case "write_failed": return qsTr("This could not be saved on the reader.")
        case "server_error": return qsTr("The server reported a problem.")
        case "not_found": return qsTr("The file is no longer on the server.")
        case "locked": return qsTr("The file is locked on the server.")
        case "connection_lost": return qsTr("The connection was lost.")
        case "not_enough_space": return qsTr("There is not enough free space on the reader.")
        case "too_large_for_storage": return qsTr("This file is too large for the reader's storage.")
        case "storage_readonly": return qsTr("The reader's storage cannot be written to.")
        case "checksum_mismatch": return qsTr("The downloaded file did not match the checksum of the server.")
        case "size_mismatch": return qsTr("The downloaded file has the wrong size.")
        case "local_changed": return qsTr("The copy on the reader has been changed.")
        case "path_too_long": return qsTr("The folder path is too long for the reader's storage.")
        case "path_unsafe": return qsTr("A link or a file is in the way in the download folder.")
        case "server_storage_full": return qsTr("The storage on the server is full.")
        case "file_too_large_server": return qsTr("The server does not accept a file this large.")
        case "type_not_accepted": return qsTr("The server does not accept this type of file.")
        case "name_forbidden": return qsTr("The server does not accept this name.")
        case "not_allowed": return qsTr("You are not allowed to do this here.")
        case "changed_on_server": return qsTr("This changed on the server since you last saw it.")
        case "name_exists": return qsTr("A file or folder with this name is already there.")
        case "target_gone": return qsTr("The folder is no longer on the server.")
        case "source_gone": return qsTr("The entry is no longer on the server.")
        case "partial_failure": return qsTr("Some entries could not be changed.")
        case "server_refused": return qsTr("The server refused this without saying why.")
        case "queue_full": return qsTr("The queue is full.")
        case "refresh_first": return qsTr("The folder needs a refresh first.")
        case "change_pending": return qsTr("A change of this entry is waiting in the queue already.")
        case "source_unreadable": return qsTr("This file is empty or cannot be read.")
        case "source_changed": return qsTr("The file on the reader changed while it was being sent.")
        case "source_not_allowed": return qsTr("This file cannot be uploaded from here.")
        case "trash_unavailable": return qsTr("This server has no trash.")
        case "outcome_unknown":
        case "no_answer": return qsTr("The reader could not tell whether this reached the server.")
        case "other_account": return qsTr("This belongs to another account.")
        case "no_connection": return qsTr("There is no connection.")
        case "cancelled": return qsTr("The download was cancelled.")
        case "listing_too_large": return qsTr("This folder has too many entries for the reader.")
        case "foreign_href": return qsTr("The server named a place outside your files.")
        case "qr_too_long": return qsTr("The QR code holds more text than the app accepts.")
        // folder synchronization (specs/003-folder-sync)
        case "pair_limit": return qsTr("There are already 8 pairs.")
        case "pair_overlap": return qsTr("This folder overlaps with another pair.")
        case "pair_folder_forbidden": return qsTr("This folder cannot be used for a pair.")
        case "pair_limit_invalid": return qsTr("These limits cannot be used.")
        case "confirmation_needed": return qsTr("This needs your confirmation.")
        case "sync_busy": return qsTr("A sync is already running for this pair.")
        case "plan_stale": return qsTr("The comparison is too old.")
        case "plan_not_approvable": return qsTr("This plan cannot be approved as it is.")
        case "plan_too_large": return qsTr("There are too many changes to review at once.")
        case "over_limit": return qsTr("The plan is over the limit of the pair.")
        case "records_full": return qsTr("The sync cannot keep track of more files.")
        case "changed_during_sync": return qsTr("This changed while the sync was running.")
        case "in_sync": return qsTr("Already in sync.")
        case "identical": return qsTr("The same on both sides.")
        case "hidden_name": return qsTr("Names that start with a dot are hidden and are not synchronized.")
        case "direction": return qsTr("The direction of this pair does not allow it.")
        case "kept_both": return qsTr("Both versions are kept.")
        case "by_user": return qsTr("You took this out of the plan.")
        case "server_version_unknown": return qsTr("The server did not name the version of this file.")
        case "unavailable": return qsTr("You cannot use this entry on the server.")
        case "quota_exceeded": return qsTr("There is not enough space on the server for this file.")
        case "no_space": return qsTr("There is not enough free space on the reader for this.")
        case "over_reserve": return qsTr("This would use the space the sync keeps free.")
        case "name_collision": return qsTr("Another file already has this name.")
        case "server_folder_missing": return qsTr("The server folder is gone.")
        case "reader_folder_missing": return qsTr("The reader folder is not available.")
        case "account_changed": return qsTr("This pair belongs to another account.")
        case "managed_by_sync": return qsTr("This file is managed by a Sync pair.")
        // share links (specs/004-share-links)
        case "share_not_offered": return qsTr("This server does not offer sharing.")
        case "share_public_disabled": return qsTr("Public links are not allowed on this server.")
        case "share_password_required": return qsTr("This server requires a password for links.")
        case "share_expiry_required": return qsTr("This server requires an expiry date for links.")
        case "share_expiry_too_far": return qsTr("The date is too far away.")
        case "share_upload_not_allowed": return qsTr("This server does not allow uploads through public links.")
        case "share_item_not_shareable": return qsTr("This item cannot be shared.")
        case "share_item_gone": return qsTr("This item no longer exists where it was.")
        case "share_not_changeable": return qsTr("You may not change this share.")
        case "share_gone": return qsTr("This link no longer exists.")
        case "share_changed_meanwhile": return qsTr("This link was changed meanwhile.")
        case "share_unknown_outcome": return qsTr("The request was sent, but no answer arrived. The list may be out of date.")
        case "share_list_too_big": return qsTr("More shares exist than can be listed here.")
        case "share_refused": return qsTr("The server refused the request.")
        case "expiry_invalid": return qsTr("The date is not valid. Use YYYY-MM-DD.")
        case "expiry_in_past": return qsTr("The date has passed.")
        case "password_invalid": return qsTr("The password is not valid. Use 1 to 256 characters.")
        case "permission_invalid": return qsTr("This permission is not possible for a file.")
        default: return qsTr("Something went wrong.")
        }
    }

    function action(key) {
        switch (key) {
        case "": return ""
        case "scheme_not_allowed": return qsTr("Type the address with https:// or just the name of the server.")
        case "address_invalid": return qsTr("Type the address of your server, for example cloud.example.org.")
        case "clock_implausible": return qsTr("Set the date and time in the reader's settings, then try again.")
        case "no_network": return qsTr("Switch on Wi-Fi and try again.")
        case "server_unreachable": return qsTr("Check the address and the Wi-Fi connection.")
        case "timeout": return qsTr("Try again later.")
        case "cert_untrusted": return qsTr("If your server uses your own certificate authority, put its certificate as custom-ca.pem in the app's data folder. The check cannot be switched off.")
        case "cert_expired": return qsTr("Check the reader's date and time first. If they are right, the certificate of the server needs to be renewed.")
        case "cert_host_mismatch": return qsTr("Check the address you typed.")
        case "not_nextcloud": return qsTr("Use the address you open in the browser to reach your files.")
        case "maintenance": return qsTr("Try again later.")
        case "server_too_old": return qsTr("Nextcloud 30 or newer is needed. Ask the administrator to update the server.")
        case "auth_failed": return qsTr("If your account uses two-factor authentication, an app password is needed: create one in Nextcloud under Settings > Security.")
        case "auth_app_password_required": return qsTr("Create one in Nextcloud under Settings > Security and use it here instead of your account password.")
        case "no_webdav": return qsTr("Check the address. The administrator may have switched off WebDAV.")
        case "forbidden": return qsTr("Ask the administrator of the server.")
        case "rate_limited": return qsTr("Wait a few minutes and try again.")
        case "redirect_other_host": return qsTr("For your safety the app does not follow it. Use the address of the server itself.")
        case "login_failed":
        case "login_expired": return qsTr("Start the login again.")
        case "protocol_error":
        case "malformed_xml": return qsTr("Try again. If it keeps failing, this server may not be supported.")
        case "storage_full":
        case "write_failed": return qsTr("Free some space on the reader and try again.")
        case "server_error": return qsTr("Try again later.")
        case "not_found": return qsTr("Refresh the folder to see what is there now.")
        case "locked": return qsTr("Try again later.")
        case "connection_lost": return qsTr("Check the Wi-Fi connection and try again.")
        case "not_enough_space": return qsTr("Remove downloaded files on the Storage page and try again.")
        case "too_large_for_storage": return qsTr("Files of 4 GB or more cannot be stored on this reader.")
        case "storage_readonly": return qsTr("Check the memory card and try again.")
        case "checksum_mismatch":
        case "size_mismatch": return qsTr("The file was discarded. Try again.")
        case "local_changed": return qsTr("Choose what to do with your copy.")
        case "path_too_long": return qsTr("Rename the folder on the server.")
        case "path_unsafe": return qsTr("Check the download folder on the reader.")
        case "server_storage_full": return qsTr("Free some space on the server or ask the administrator to raise your quota.")
        case "file_too_large_server": return qsTr("Send a smaller file, or ask the administrator about the upload limit.")
        case "type_not_accepted": return qsTr("Remove it from the queue, or ask the administrator.")
        case "name_forbidden": return qsTr("Use another name.")
        case "not_allowed": return qsTr("Ask the owner of the folder or the administrator of the server.")
        case "change_pending": return qsTr("Send the queue first, or remove the waiting change.")
        case "changed_on_server": return qsTr("Refresh the folder, then choose what to do.")
        case "name_exists": return qsTr("Choose another name, or keep both.")
        case "target_gone": return qsTr("Refresh the folder and choose another one.")
        case "source_gone": return qsTr("Refresh the folder to see what is there now.")
        case "partial_failure": return qsTr("Refresh the folder to see what happened.")
        case "server_refused": return qsTr("Try again later, or ask the administrator.")
        case "queue_full": return qsTr("Send the queue first, or remove items you do not need.")
        case "refresh_first": return qsTr("Refresh the folder, then try again.")
        case "source_unreadable": return qsTr("Check the file on the reader.")
        case "source_changed": return qsTr("It is sent again from its new content.")
        case "source_not_allowed": return qsTr("Pick a file from your own folders.")
        case "trash_unavailable": return qsTr("Deleting here would be permanent, so PB Cloud does not offer it.")
        case "outcome_unknown":
        case "no_answer": return qsTr("Check the server before you send it again.")
        case "other_account": return qsTr("It is kept and not sent. Connect that account again to send it.")
        case "no_connection": return qsTr("Switch on Wi-Fi and send again.")
        case "cancelled": return ""
        case "listing_too_large": return qsTr("Open this folder in the Nextcloud web interface.")
        case "foreign_href": return qsTr("That entry was left out. Nothing else to do.")
        case "qr_too_long": return qsTr("Type the app password by hand instead.")
        // folder synchronization (specs/003-folder-sync)
        case "pair_limit": return qsTr("Remove a pair you do not need first.")
        case "pair_overlap": return qsTr("Choose a folder that no other pair uses.")
        case "pair_folder_forbidden": return qsTr("Choose a folder of your own, not the app's data or download folder.")
        case "pair_limit_invalid": return qsTr("Use 1 to 5,000 files and 1 MB to 64 GB.")
        case "confirmation_needed": return qsTr("Confirm that files may be sent to the server.")
        case "sync_busy": return qsTr("Wait until it has finished.")
        case "plan_stale": return qsTr("Compare again before you approve.")
        case "plan_not_approvable": return qsTr("Read the reason shown and compare again.")
        case "plan_too_large": return qsTr("Use a smaller folder, or split the pair into two.")
        case "over_limit": return qsTr("Raise the limit, or take entries out of the plan.")
        case "records_full": return qsTr("Remove a pair you do not need.")
        case "changed_during_sync": return qsTr("It is looked at again at the next sync.")
        case "in_sync": return qsTr("Nothing to do.")
        case "identical": return qsTr("It is remembered as in sync when you approve the plan.")
        case "hidden_name": return qsTr("Rename it on the server if you want it on the reader.")
        case "direction": return qsTr("Change the direction of the pair if you want this.")
        case "kept_both": return qsTr("Nothing more happens to them.")
        case "by_user": return qsTr("It comes back at the next sync.")
        case "server_version_unknown": return qsTr("Refresh the folder and compare again.")
        case "unavailable": return qsTr("Ask the owner of the folder.")
        case "quota_exceeded": return qsTr("Free some space on the server or ask the administrator.")
        case "no_space": return qsTr("Remove downloaded files, or take entries out of the plan.")
        case "over_reserve": return qsTr("Take entries out of the plan.")
        case "name_collision": return qsTr("Rename one of them.")
        case "server_folder_missing": return qsTr("Check the folder on the server, or change the pair.")
        case "reader_folder_missing": return qsTr("Insert the memory card, or change the pair.")
        case "account_changed": return qsTr("Remove the pair, or connect that account again.")
        case "managed_by_sync": return qsTr("Change or remove the pair on the Sync screen.")
        case "share_not_offered": return qsTr("Nothing else in the app is affected.")
        case "share_public_disabled": return qsTr("Ask the server's administrator. Shares with users and groups are still listed.")
        case "share_password_required": return qsTr("Enter a password.")
        case "share_expiry_required": return qsTr("Enter a date.")
        case "share_expiry_too_far": return qsTr("Choose an earlier date.")
        case "share_upload_not_allowed": return qsTr("Choose read only.")
        case "share_item_not_shareable": return qsTr("Choose another item or ask the administrator.")
        case "share_item_gone": return qsTr("Refresh the folder.")
        case "share_not_changeable": return qsTr("It belongs to someone else.")
        case "share_gone": return qsTr("The list is shown again.")
        case "share_changed_meanwhile": return qsTr("Check the current settings and confirm again.")
        case "share_unknown_outcome": return qsTr("Tap Refresh. Creating again may make a second link.")
        case "share_list_too_big": return qsTr("Open the item in the web interface.")
        case "share_refused": return qsTr("Try again later.")
        case "expiry_invalid": return qsTr("Correct the entry. Nothing was sent.")
        case "expiry_in_past": return qsTr("Choose a date from today on. Nothing was sent.")
        case "password_invalid": return qsTr("Correct the entry. Nothing was sent.")
        case "permission_invalid": return qsTr("Choose read only. Nothing was sent.")
        default: return qsTr("Try again.")
        }
    }
}
